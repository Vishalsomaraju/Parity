# Parity Backend Configuration
NODE_ENV=production
PORT=4000
FRONTEND_URL=
CORS_ORIGIN=

# Database (Railway PostgreSQL + pgvector. Required in production)
DATABASE_URL=
ENABLE_WORKER=true

# AI Services (Optional - will fall back to Deterministic Heuristics if absent)
# Primary: Google Gemini (Supported: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Secondary: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Benchmark Similarity Gate (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.65
MAX_FILE_SIZE_MB=15
