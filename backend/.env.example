# Parity Backend Configuration
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database & Cache (Optional - will gracefully fall back to Degraded Session Mode)
DATABASE_URL=
REDIS_URL=
CORS_ORIGIN=
ENABLE_WORKER=false

# AI Services (Optional - will fall back to Deterministic Heuristics if absent)
# Primary: Google Gemini (Supported: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Secondary: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Benchmark Similarity Gate (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.65
MAX_FILE_SIZE_MB=15
